generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  password       String?
  emailVerified  Boolean         @default(false)
  session        Session[]
  emails         Email[]
  integrations   Integration[]
  authIdentities AuthIdentity[]
  meetings       Meeting[]
  notes          Note[]
  reminders      Reminder[]
  aiwrittenEamils AIWrittenEmail[]
  agents         AgentRun[]
  attachment     Attachment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

enum AuthProvider {
  GOOGLE
}

model AuthIdentity {
  id                String       @id @default(uuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  email             String
  createdAt         DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  refreshToken String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  userAgent    String?
  ipAddress    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum Provider {
  GMAIL
  OUTLOOK
  YAHOO
}

enum IntegrationStatus {
  ACTIVE
  DISCONNECTED
}

model Integration {
  id                String            @id @default(uuid())
  userId            String
  provider          Provider          @default(GMAIL)
  providerAccountId String
  providerEmail     String
  status            IntegrationStatus @default(ACTIVE)
  accessToken       String?           @db.Text
  refreshToken      String?           @db.Text
  expiresAt         DateTime?
  historyId         String?
  watchExpiresAt    DateTime?
  lastManualSyncAt  DateTime?
  lastSyncedAt      DateTime?
  lastSyncResult    Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([provider, providerEmail])
  @@index([userId, provider])
}

enum EmailCategory {
  PROMOTIONAL
  TRANSACTIONAL
  NOTIFICATION
  NEWSLETTER
  PERSONAL
  IMPORTANT
  SPAM
  MEETING
  FOLLOW_UP
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  AWAITING_REVIEW
  DONE
  FAILED
}

model Email {
  id                  String           @id @default(uuid())
  userId              String
  providerId          String
  subject             String
  body                String           @db.Text
  fromEmail           String?
  fromName            String?
  toEmail             String?
  needsReply          Boolean?
  toName              String?
  category            EmailCategory?
  extractionNeeded    Boolean?
  /** Which extract types classification selected, e.g. { REMINDER, MEETING, NOTE }. */
  extractIntents      Json?
  isRead              Boolean          @default(false)
  receivedAt          DateTime
  processingStatus    ProcessingStatus @default(PENDING)
  processingStartedAt DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  isReplied           Boolean          @default(false)
  aiwrittenEamils     AIWrittenEmail[]
  attachment          Attachment[]
  notes               Note[]
  reminders           Reminder[]
  meetings            Meeting[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@index([userId, receivedAt])
  @@index([userId, category])
  @@index([userId, isReplied])
  @@index([processingStatus, createdAt])
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  REJECTED
}

model Attachment {
  id                   String     @id @default(uuid())
  userId               String
  emailId              String
  providerAttachmentId String
  filename             String
  originalFilename     String?
  mimeType             String
  declaredMimeType     String?
  sizeBytes            Int
  sha256               String
  isInline             Boolean    @default(false)
  contentId            String?
  storageKey           String?
  scanStatus           ScanStatus @default(PENDING)
  scanNote             String?
  extractedText        String?    @db.Text
  createdAt            DateTime   @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@unique([emailId, providerAttachmentId])
  @@index([emailId])
  @@index([userId, sha256])
}

enum Decision {
  APPROVED
  REJECTED
  PENDING
  EDIT_SUGGESTION
  SKIPPED
}

enum Status {
  PENDING
  IN_PROGRESS
  SEND
  FAILED
}

model AIWrittenEmail {
  id           String    @id @default(uuid())
  userId       String
  emailId      String
  subject      String
  body         String    @db.Text
  decision     Decision  @default(PENDING)
  aiModel      String
  status       Status    @default(PENDING)
  round        Int       @default(0)
  instructions String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@unique([emailId, round])
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

model Meeting {
  id            String        @id @default(uuid())
  userId        String
  emailId       String?
  createdByAI   Boolean       @default(false)
  attendeeEmail String
  attendeeName  String?
  title         String
  description   String?
  providerId    String?
  timezone      String
  meetingLink   String
  startTime     DateTime
  endTime       DateTime
  status        MeetingStatus @default(SCHEDULED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  email Email? @relation(fields: [emailId], references: [id], onDelete: SetNull)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startTime])
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  emailId   String?
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  email Email? @relation(fields: [emailId], references: [id], onDelete: SetNull)

  @@index([userId, emailId])
}

model Reminder {
  id          String   @id @default(uuid())
  userId      String
  emailId     String
  title       String
  description String?
  date        DateTime
  isDone      Boolean  @default(false)
  createdByAI Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, emailId])
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentRunType {
  EMAIL_CLASSIFICATION
  EMAIL_RESPONSE
  MEETING_SCHEDULING
  GENERAL_CHAT
}

model AgentRun {
  id           String         @id @default(uuid())
  userId       String
  type         AgentRunType
  status       AgentRunStatus @default(PENDING)
  input        Json?
  output       Json?
  toolCalls    Json?
  error        String?
  inngestRunId String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
}
