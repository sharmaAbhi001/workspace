PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=

JWT_SECRET=
SESSION_SECRET=
STATE_SECRET=
TOKEN_ENCRYPTION_KEY=

# Google OAuth — shared client (login + Gmail connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login with Google callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Connect Gmail callback (read-email scope only)
GOOGLE_INTEGRATION_REDIRECT_URI=http://localhost:3000/api/v1/integrations/gmail/callback

# Gmail watch / Pub/Sub
PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/YOUR_TOPIC
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT=
SKIP_PUBSUB_AUTH=true

INNGEST_DEV=1

# OpenAI (email extraction via Vercel AI SDK)
OPENAI_API_KEY=

# OpenRouter (email classification via TypeSafe / Jev)
OPENROUTER_API_KEY=

# MinIO (local S3)
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=attachments
MINIO_REGION=us-east-1
